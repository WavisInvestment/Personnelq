# Copy to .env.production and fill in. Never commit the real file.

# Your public address, without https:// (DNS A record must already point at this server)
DOMAIN=app.example.com

# Database (choose a long random password)
POSTGRES_PASSWORD=
# POSTGRES_USER=personnelq
# POSTGRES_DB=personnelq

# Generate each with:  openssl rand -base64 48   (two different values)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Master switch: false = the whole product is free (no payment for the full assessment, companies need no plan).
PAYMENTS_ENABLED=true
# With payments off, how many people each company can have
FREE_ORGANIZATION_SEATS=500

# Shown on the Privacy and Terms pages so people know who to write to. Needs a rebuild (up --build) to change.
CONTACT_EMAIL=

# Payments (Paystack). Leave empty to switch purchases off.
PAYSTACK_SECRET_KEY=
PAYMENT_CURRENCY=NGN
FULL_ASSESSMENT_PRICE=
# Example: [{"slug":"team","name":"Team","seats":25,"amount":50000,"billing_cycle":"monthly"}]
SUBSCRIPTION_PLANS=
# true = the full assessment needs a payment
ASSESSMENT_PAYMENT_REQUIRED=false

# Written insights (Anthropic). Leave empty to switch off.
CLAUDE_API_KEY=

# Email (Resend). FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
FROM_EMAIL=

# First platform admin: set both, deploy once, then delete them (the account stays).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
