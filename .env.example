# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/personnelq_dev
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/personnelq_test

# JWT
JWT_SECRET=your-256-bit-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-change-in-production
JWT_EXPIRY=900s

# Assessments: set to true once payments are live. The full assessment then needs one successful
# payment per attempt (the free snapshot is never charged). Leave false until then.
ASSESSMENT_PAYMENT_REQUIRED=false

# Rate limiting (global default per IP; auth endpoints have stricter built-in limits)
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
# Number of proxies in front of the API (e.g. 1 behind a load balancer); leave unset locally
# TRUST_PROXY=1
JWT_REFRESH_EXPIRY=604800

# Master switch for money. Set to false to run the whole product free: nobody is asked to pay for the full
# assessment, companies need no plan to invite people, and the checkout endpoints refuse. Payments that were
# already in progress still settle. Default is on.
PAYMENTS_ENABLED=true
# With payments off, how many people each company can have (there are no plans to set a limit)
# FREE_ORGANIZATION_SEATS=500

# Paystack (payments). Without a real secret key, purchases are simply unavailable.
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
# Webhook: in the Paystack dashboard set the URL to https://<your-api>/api/webhooks/paystack
# Prices are set here, never taken from the browser. Amounts are in major units (5000 = NGN 5,000).
PAYMENT_CURRENCY=NGN
FULL_ASSESSMENT_PRICE=
# Company plans, as JSON (billing_cycle: monthly | annual). Leave empty to sell none.
# SUBSCRIPTION_PLANS=[{"slug":"team","name":"Team","description":"Up to 25 people","seats":25,"amount":50000,"billing_cycle":"monthly"}]
SUBSCRIPTION_PLANS=

# Claude API (written insights). Only the five trait scores are sent, never a name or email.
CLAUDE_API_KEY=sk-ant-xxxxx
# CLAUDE_MODEL=claude-sonnet-5-5

# PDF reports use a locally installed Chrome or Edge. Set this if it isn't found automatically.
# PUPPETEER_EXECUTABLE_PATH=

# Email (receipts, password resets, emailed reports)
RESEND_API_KEY=re_xxxxx
# Must be on a domain verified in Resend. For a quick test use onboarding@resend.dev (delivers only to your own Resend account email).
FROM_EMAIL=onboarding@resend.dev

# Where the website lives. Paystack returns customers here, and emails link here.
FRONTEND_URL=http://localhost:3000

# Frontend
# Address of the website (used for share links and previews) and the contact address on the Privacy and Terms pages
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Environment
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000

# Scheduled housekeeping (plan expiry warnings, closing expired invitations, clearing stale sessions).
# On in production by default. Elsewhere set true to run it, which will email real administrators if email is configured.
JOBS_ENABLED=
JOBS_INTERVAL_MS=3600000
