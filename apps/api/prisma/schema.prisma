// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. ORGANIZATIONS & USERS
// ============================================

model Organization {
  id     String @id @default(cuid())
  name   String
  slug   String @unique
  type   String @default("corporate") // corporate | school | church | professional
  status String @default("active") // active | inactive | suspended

  // Admin details
  admin_name  String
  admin_email String
  admin_phone String?

  // Set when platform staff suspend the company (status becomes "suspended"); shown to its administrators.
  suspended_at     DateTime?
  suspended_reason String?

  // Subscription
  subscription_plan     String    @default("free")
  subscription_status   String    @default("inactive")
  subscription_end_date DateTime?
  max_employees         Int       @default(10)

  // Timestamps
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  members              OrganizationMember[]
  assessments          Assessment[]
  submissions          AssessmentSubmission[]
  results              AssessmentResult[]
  personality_profiles PersonalityProfile[]
  invitations          EmployeeInvitation[]
  payments             Payment[]
  subscriptions        Subscription[]
  audit_logs           AuditLog[]
  reports              Report[]
  retake_requests      RetakeRequest[]

  @@index([slug])
  @@index([type])
  @@index([status])
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  email_verified    Boolean   @default(false)
  email_verified_at DateTime?

  // Set when this account was created from a company invitation link: that company is the one the person cannot leave.
  joined_via_organization_id String?

  // Auth
  password_hash          String
  password_reset_token   String?
  password_reset_expires DateTime?

  // Email verification (hashed token). pending_email holds a new address until its owner confirms it.
  email_verify_token   String?
  email_verify_expires DateTime?
  pending_email        String?

  // Platform access: null for regular users. Set only via the admin:create script, never via signup.
  platform_role_id String?
  // Personal role every account holds ('individual'): baseline for taking assessments and seeing own results.
  account_role_id  String?

  // Account lockout
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?

  // Profile
  first_name   String
  last_name    String
  phone_number String?
  avatar_url   String?

  // Preferences
  preferred_language String @default("en")
  timezone           String @default("UTC")

  // Set when platform staff block the account: sign-in and every request are refused while it is set.
  suspended_at     DateTime?
  suspended_reason String?

  // Timestamps
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  platform_role        Role?                  @relation("PlatformRole", fields: [platform_role_id], references: [id], onDelete: SetNull)
  account_role         Role?                  @relation("AccountRole", fields: [account_role_id], references: [id], onDelete: SetNull)
  organization_members OrganizationMember[]
  sessions             Session[]
  assessments_created  Assessment[]           @relation("created_by")
  submissions          AssessmentSubmission[]
  results              AssessmentResult[]
  invitations_received EmployeeInvitation[]   @relation("recipient")
  invitations_sent     EmployeeInvitation[]   @relation("sender")
  shareable_badges     ShareableBadge[]
  payments             Payment[]
  audit_logs           AuditLog[]             @relation("user")
  audit_logs_actor     AuditLog[]             @relation("actor")
  retake_requests      RetakeRequest[]

  @@index([email])
  @@index([deleted_at])
  @@index([platform_role_id])
  @@index([account_role_id])
}

// ============================================
// ROLES & PERMISSIONS (RBAC)
// ============================================
// Roles and permissions are rows, not strings. Permissions belong to roles only; users get
// permissions through a role: platform staff via User.platform_role_id, and company members via
// OrganizationMember.role_id (a person can hold a different role in each company).
// System roles and the permission catalogue are kept in sync from code at API startup.

model Role {
  id          String  @id @default(cuid())
  scope       String // platform | organization | account
  key         String // super_admin | support | admin | hr | employee | member
  name        String
  description String?
  is_system   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  permissions    RolePermission[]
  platform_users User[]               @relation("PlatformRole")
  account_users  User[]               @relation("AccountRole")
  memberships    OrganizationMember[]

  @@unique([scope, key])
  @@index([scope])
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. view:payments
  scope       String // platform | organization | account
  description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  roles RolePermission[]

  @@index([scope])
}

model RolePermission {
  role_id       String
  permission_id String
  created_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
}

model OrganizationMember {
  id              String @id @default(cuid())
  user_id         String
  organization_id String

  // Role (organization-scoped Role row: admin | hr | employee | member)
  role_id    String
  department String?
  job_title  String?

  // Status
  status String @default("active") // active | inactive | invited | suspended

  // Why a company administrator paused this person's access (status "suspended"); the person is not told this text.
  suspended_reason String?

  // When the person accepted an invitation that told them the company sees the results they take through it.
  // Only people with this set are part of the team HR can see.
  consented_at DateTime?

  // Timestamps
  joined_at  DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([user_id, organization_id])
  @@index([organization_id])
  @@index([role_id])
  @@index([status])
}

// ============================================
// 2. SESSIONS & AUTHENTICATION
// ============================================

model Session {
  id      String @id @default(cuid())
  user_id String

  // Token details
  refresh_token String @unique
  token_version Int    @default(1)

  // Tracking
  ip_address String
  user_agent String

  // Expiry
  expires_at DateTime

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

// ============================================
// 3. ASSESSMENTS (TESTS)
// ============================================

model Assessment {
  id              String  @id @default(cuid())
  // null = a platform-owned assessment (the official Personnelq tests)
  organization_id String?

  // Basic info
  slug        String? // stable key for platform assessments, e.g. ocean-full
  name        String
  description String?
  type        String  @default("full_assessment")
  framework   String  @default("ocean")
  version     String  @default("1.0.0")

  // Configuration
  is_locked            Boolean @default(false)
  allow_retake         Boolean @default(false)
  retake_interval_days Int     @default(180)

  // Scoring
  total_questions Int
  scoring_method  String @default("ocean") // ocean | custom

  // Company-made assessments only: sections (name, weight, what a low/medium/high score means). Frozen once published.
  definition Json?

  // Timestamps
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  published_at DateTime?
  deleted_at   DateTime?
  created_by   String?

  // Relations
  organization    Organization?          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  creator         User?                  @relation("created_by", fields: [created_by], references: [id], onDelete: SetNull)
  questions       AssessmentQuestion[]
  submissions     AssessmentSubmission[]
  results         AssessmentResult[]
  invitations     EmployeeInvitation[]
  retake_requests RetakeRequest[]

  @@unique([slug, version])
  @@index([organization_id])
  @@index([type])
  @@index([framework])
  @@index([is_locked])
}

model AssessmentQuestion {
  id            String @id @default(cuid())
  assessment_id String

  // Question details
  question_number Int
  question_text   String
  question_type   String @default("likert")

  // OCEAN mapping
  ocean_trait     String?
  ocean_direction String? @default("positive")

  // Custom assessments: the section this question scores into (a key from Assessment.definition)
  section_key String?

  // Scoring
  weight    Float @default(1.0)
  min_score Int   @default(1)
  max_score Int   @default(5)

  // Options
  options       String[]
  option_values Int[]

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  assessment Assessment         @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]

  @@unique([assessment_id, question_number])
  @@index([assessment_id])
  @@index([ocean_trait])
}

// ============================================
// 4. SUBMISSIONS & RESPONSES
// ============================================

model AssessmentSubmission {
  id              String  @id @default(cuid())
  user_id         String
  organization_id String? // null = taken as an individual, outside any company
  assessment_id   String

  // Submission status
  status String @default("in_progress")

  // Progress tracking
  current_question Int @default(0)
  progress_percent Int @default(0)

  // Timing
  started_at       DateTime  @default(now())
  completed_at     DateTime?
  last_activity_at DateTime  @updatedAt
  duration_seconds Int?

  // Version tracking
  submission_number      Int     @default(1)
  is_current             Boolean @default(true)
  previous_submission_id String?

  // Assessment lock status
  is_locked     Boolean @default(false)
  locked_reason String?

  // Employee invitation
  invitation_id String?

  // Timestamps
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  user         User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization Organization?       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  assessment   Assessment          @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  invitation   EmployeeInvitation? @relation(fields: [invitation_id], references: [id], onDelete: SetNull)
  answers      AssessmentAnswer[]
  result       AssessmentResult?

  @@unique([user_id, assessment_id, submission_number])
  @@index([organization_id])
  @@index([assessment_id])
  @@index([status])
  @@index([is_locked])
  @@index([invitation_id])
}

model AssessmentAnswer {
  id            String @id @default(cuid())
  submission_id String
  question_id   String

  // Response
  answer_value Int     @default(0)
  answer_text  String?

  // Timing
  time_spent_seconds Int @default(0)

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  submission AssessmentSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  question   AssessmentQuestion   @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, question_id])
  @@index([submission_id])
  @@index([question_id])
}

// ============================================
// 5. RESULTS & SCORING
// ============================================

model AssessmentResult {
  id              String  @id @default(cuid())
  user_id         String
  organization_id String?
  assessment_id   String
  submission_id   String  @unique

  // OCEAN Scores
  openness_score          Float? @default(0)
  conscientiousness_score Float? @default(0)
  extraversion_score      Float? @default(0)
  agreeableness_score     Float? @default(0)
  neuroticism_score       Float? @default(0)

  // Overall
  overall_score Float @default(0)
  percentile    Int?

  // Custom assessments: section scores with the interpretation text as it was when taken. OCEAN columns stay empty.
  custom_scores Json?

  // Assessment version
  result_version     String  @default("1.0.0")
  is_current         Boolean @default(true)
  previous_result_id String?

  // AI Interpretation
  ai_interpretation String?
  ai_generated_at   DateTime?
  ai_model          String?   @default("claude-3-sonnet")

  // Timestamps
  calculated_at DateTime  @default(now())
  shared_at     DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  // Relations
  user            User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization    Organization?        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  assessment      Assessment           @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  submission      AssessmentSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  shareable_badge ShareableBadge?

  @@unique([user_id, assessment_id, submission_id])
  @@index([organization_id])
  @@index([assessment_id])
  @@index([is_current])
  @@index([organization_id, is_current])
  @@index([user_id, created_at])
}

// ============================================
// 6. PERSONALITY PROFILES
// ============================================

model PersonalityProfile {
  id              String @id @default(cuid())
  user_id         String
  organization_id String

  // Consolidated scores
  openness_score          Float? @default(0)
  conscientiousness_score Float? @default(0)
  extraversion_score      Float? @default(0)
  agreeableness_score     Float? @default(0)
  neuroticism_score       Float? @default(0)

  // Profile version
  version    Int     @default(1)
  is_current Boolean @default(true)

  // Metadata
  result_ids String[]

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([user_id, organization_id])
  @@index([is_current])
}

// ============================================
// 7. SHAREABLE BADGES
// ============================================

model ShareableBadge {
  id        String @id @default(cuid())
  user_id   String
  result_id String @unique

  // Share token
  share_token String @unique @default(cuid())
  share_url   String @unique

  // Privacy settings
  is_public    Boolean   @default(false)
  published_at DateTime?
  expires_at   DateTime?

  // Shared elements
  shared_elements Json @default("{}")

  // Access tracking
  view_count     Int       @default(0)
  last_viewed_at DateTime?

  // Custom settings
  display_name   String?
  custom_message String?

  // Timestamps
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  user   User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  result AssessmentResult @relation(fields: [result_id], references: [id], onDelete: Cascade)

  @@index([share_token])
  @@index([user_id])
  @@index([is_public])
}

// ============================================
// 8. EMPLOYEE INVITATIONS
// ============================================

model EmployeeInvitation {
  id              String @id @default(cuid())
  organization_id String
  sender_id       String
  recipient_email String

  // Invitation details
  first_name String?
  last_name  String?
  department String?
  job_title  String?
  // The company role the person joins with: employee | hr | admin
  role_key   String  @default("employee")

  // Unique link
  invitation_token String @unique @default(cuid())
  invitation_url   String @unique

  // Expiry
  expires_at DateTime

  // Status
  status              String    @default("pending")
  accepted_at         DateTime?
  accepted_by_user_id String?

  // Assessment
  assessment_id String

  // Set to "<company>:<email>" while the invitation is waiting and cleared when it is accepted, cancelled or
  // expired. The unique index on it makes "one waiting invitation per person per company" a database rule.
  open_key String? @unique

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  organization Organization           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  sender       User                   @relation("sender", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient    User?                  @relation("recipient", fields: [accepted_by_user_id], references: [id], onDelete: SetNull)
  assessment   Assessment             @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  submissions  AssessmentSubmission[]

  @@index([organization_id])
  @@index([recipient_email])
  @@index([status])
  @@index([expires_at])
  @@index([organization_id, status])
}

// A company member asking to repeat an assessment they already took through the company, or HR allowing it first.
// Approving gives a fresh 14 days to start; starting uses it up.
model RetakeRequest {
  id              String @id @default(cuid())
  organization_id String
  user_id         String
  assessment_id   String

  status       String  @default("requested") // requested | approved | declined | used | cancelled
  requested_by String  @default("member") // member | hr
  decided_by   String?

  expires_at DateTime?
  decided_at DateTime?
  used_at    DateTime?

  // "<company>:<person>:<assessment>" while the request is live (waiting or approved), cleared when it ends.
  // The unique index makes "one live request per person per assessment per company" a database rule.
  open_key String? @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  assessment   Assessment   @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
  @@index([user_id, assessment_id, status])
}

// ============================================
// 9. CUSTOM ASSESSMENTS
// ============================================

// ============================================
// 10. PAYMENTS & SUBSCRIPTIONS
// ============================================

model Payment {
  id              String  @id @default(cuid())
  organization_id String? // null = an individual paying for themselves
  user_id         String?

  // Payment details
  amount         Float
  currency       String @default("USD")
  status         String @default("pending")
  payment_method String

  // Payment processor
  payment_provider   String @default("paystack")
  provider_reference String @unique

  // Paystack specifics
  paystack_reference String?
  authorization_url  String?
  access_code        String?

  // Assessment/Subscription
  payment_type      String
  assessment_id     String?
  subscription_plan String?

  // Metadata
  description String?
  metadata    Json    @default("{}")

  // Timestamps
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  processed_at DateTime?

  // Relations
  organization Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([user_id, assessment_id])
  @@index([status])
  @@index([payment_provider])
  @@index([provider_reference])
}

model Subscription {
  id              String @id @default(cuid())
  organization_id String @unique

  // Subscription details
  plan_name String
  status    String @default("inactive")

  // Billing
  billing_cycle String @default("monthly")
  amount        Float
  currency      String @default("USD")

  // Period
  start_date DateTime
  end_date   DateTime
  auto_renew Boolean  @default(true)

  // Usage limits
  seats_used  Int @default(0)
  seats_limit Int @default(10)

  // Timestamps
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  cancelled_at DateTime?

  // The last "your plan is ending" notice sent for this period: 7d | 1d | ended. Reset when the plan is renewed.
  last_expiry_notice String?

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([end_date])
}

// ============================================
// 11. AUDIT LOGS
// ============================================

model AuditLog {
  id              String @id @default(cuid())
  organization_id String
  user_id         String
  actor_id        String

  // Action details
  action        String
  resource_type String
  resource_id   String

  // Changes
  changes Json?

  // Context
  ip_address    String?
  user_agent    String?
  status        String  @default("success")
  error_message String?

  // Timestamps
  created_at DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation("user", fields: [user_id], references: [id], onDelete: Cascade)
  actor        User         @relation("actor", fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([user_id])
  @@index([action])
  @@index([resource_type])
  @@index([created_at])
  @@index([organization_id, created_at])
}

// ============================================
// 12. REPORTS & EXPORTS
// ============================================

model Report {
  id              String @id @default(cuid())
  organization_id String
  user_id         String

  // Report details
  report_type String
  title       String

  // Content
  pdf_url      String?
  generated_at DateTime

  // Timestamps
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([report_type])
}

// ============================================
// 13. SAFE RETRIES
// ============================================

// Every event a payment provider sends us, kept so a repeat is recognised and a failure can be replayed.
model WebhookEvent {
  id         String  @id @default(cuid())
  provider   String // paystack
  dedupe_key String // sha256 of the raw request body: a provider's retry is byte-for-byte identical
  event_type String
  reference  String?
  payload    Json

  status       String    @default("received") // received | processed | ignored | failed
  attempts     Int       @default(0)
  error        String?
  received_at  DateTime  @default(now())
  processed_at DateTime?
  updated_at   DateTime  @updatedAt

  @@unique([provider, dedupe_key])
  @@index([status])
  @@index([reference])
  @@index([received_at])
}

// A caller-chosen Idempotency-Key and what we answered the first time, so a retried request does not repeat its effect.
model IdempotencyKey {
  id           String @id @default(cuid())
  user_id      String
  key          String
  method       String
  path         String
  request_hash String // method + path + body, so reusing a key for a different request is caught

  state           String   @default("in_progress") // in_progress | done
  response_status Int?
  response_body   Json?
  created_at      DateTime @default(now())
  expires_at      DateTime

  @@unique([user_id, key])
  @@index([expires_at])
}

// ============================================
// 14. PLATFORM STAFF ACTIONS
// ============================================

// What platform staff did to a person, company or payment, and why. Kept even if the staff member's account is deleted.
model StaffAction {
  id          String   @id @default(cuid())
  actor_id    String
  actor_name  String
  action      String // user.suspended | user.reactivated | user.unlocked | user.reset_sent | organization.suspended | organization.reactivated | payment.refunded
  target_type String // user | organization | payment
  target_id   String
  reason      String?
  details     Json?
  created_at  DateTime @default(now())

  @@index([target_type, target_id, created_at])
  @@index([actor_id])
}
